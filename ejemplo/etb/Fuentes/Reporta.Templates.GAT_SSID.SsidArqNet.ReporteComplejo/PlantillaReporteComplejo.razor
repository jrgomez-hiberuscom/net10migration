            @if (@Model.Aceptacion != null)
            {
                <p dir="ltr" class="pt-Normal-000006">
                    <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">1.- ACEPTACIÓN *</span>
                </p>

                <div align="left">

                    <table dir="ltr" class="pt-000009">
                        <tr>
                            <td class="pt-000044">
                                <p dir="ltr" class="pt-Normal-000006">
