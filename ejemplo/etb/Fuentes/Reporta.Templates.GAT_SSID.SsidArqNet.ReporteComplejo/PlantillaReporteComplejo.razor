            @if (@Model.Finalizacion != null)
            {
                <p dir="ltr" class="pt-Normal-000006">
                    <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Finalización Extraordinaria *</span>
                </p>

                <div align="left">

                    <table dir="ltr" class="pt-000009">
                        <tr>
                            <td class="pt-000010">
                                <p dir="ltr" class="pt-Normal-000006">
                                    <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000011">Fecha</span>
                                </p>
                            </td>
                            <td class="pt-000012">
                                <p dir="ltr" class="pt-Normal-000006">
                                    <span xml:space="preserve" class="pt-000013"> @Model.Finalizacion.Fecha.ToString("dd/MM/yyyy")</span>
