                                            <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Grado Cumplimiento</span>
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="pt-000053">
                                        <p dir="ltr" class="pt-Normal-000046">
                                            <span xml:space="preserve" class="pt-000022"> @objetivo.PeriodoEjecucion</span>
                                        </p>
                                    </td>
                                    <td class="pt-000054">
                                        <p dir="ltr" class="pt-Normal-000046">
                                            <span xml:space="preserve" class="pt-000022">  @objetivo.PersonasObjetivo</span>
                                        </p>
                                    </td>
                                    <td class="pt-000055">
                                        <p dir="ltr" class="pt-Normal-000046">
                                            <span xml:space="preserve" class="pt-000022">  @objetivo.GradoCumplimiento</span>
                                        </p>
                                    </td>
                                </tr>
                            </table>

                        </div>

                        <br />

                        @foreach (var objetivoEspecifico in objetivo.ObjetivosEspecificos)
                        {
                            {
                                ++CantidadObjetivosEspecificos;
                            }

                            <div align="left">

                                <table dir="ltr" class="pt-000047">
                                    <tr>
                                        <td class="pt-000056">
                                            <p dir="ltr" class="pt-Normal-000046">
                                                <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Objetivo Específico@(CantidadObjetivosEspecificos)</span>
                                            </p>
                                        </td>
                                        <td class="pt-000057">
                                            <p dir="ltr" class="pt-Normal-000046">
                                                <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Periodo Ejecución</span>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="pt-000056">
                                            <p dir="ltr" class="pt-Normal-000046">
                                                <span xml:space="preserve" class="pt-000022">@objetivoEspecifico.Descripcion  </span>
                                            </p>
                                        </td>
                                        <td class="pt-000057">
                                            <p dir="ltr" class="pt-Normal-000046">
                                                <span xml:space="preserve" class="pt-000022">@objetivoEspecifico.PeriodoEjecucion </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="pt-000056">
                                            <p dir="ltr" class="pt-Normal-000046">
                                                <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Actuaciones</span>
                                            </p>
                                        </td>
                                        <td class="pt-000057">
                                            <p dir="ltr" class="pt-Normal-000046">
                                                <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Completado</span>
                                            </p>
                                        </td>
                                    </tr>
                                    @foreach (var actuacion in objetivoEspecifico.Actuaciones)
                                    {
                                        <tr>
                                            <td class="pt-000058">
                                                <p dir="ltr" class="pt-Normal-000046">
                                                    <span xml:space="preserve" class="pt-000022">@actuacion.Descripcion </span>
                                                </p>
                                            </td>
                                            <td class="pt-000055">
                                                <p dir="ltr" class="pt-Normal-000046">
                                                    <span xml:space="preserve" class="pt-000022">@actuacion.Completado </span>
                                                </p>
                                            </td>
                                        </tr>
                                    }
                                </table>

                            </div>
                        }
                        <br />
                    }
                }
