            {
                <p dir="ltr" class="pt-Normal-000006">
                    <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">2.- PLAN DE INTERVENCIÓN *</span>
                </p>

                <br />

                @foreach (var ambito in @Model.AmbitosPlan)
                {
                    {
                        ++CantidadAmbitos;
                        CantidadObjetivosGenerales = 0;
                    }

                    <p dir="ltr" class="pt-Normal-000046">
                        <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Ámbito@(CantidadAmbitos)</span>
                    </p>

                    @foreach (var objetivo in ambito.ObjetivosAmbito)
                    {
                        {
                            ++CantidadObjetivosGenerales;
                            CantidadObjetivosEspecificos = 0;
                        }

                        <div align="left">

                            <table dir="ltr" class="pt-000047">
                                <tr>
                                    <td colspan="3" class="pt-000048">
                                        <p dir="ltr" class="pt-Normal-000046">
                                            <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Objetivo General@(CantidadObjetivosGenerales)</span>
