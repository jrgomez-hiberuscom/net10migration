                                    <td colspan="3" class="pt-000049">
                                        <br />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="pt-000050">
                                        <p dir="ltr" class="pt-Normal-000046">
                                            <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Periodo Ejecución</span>
                                        </p>
                                    </td>
                                    <td class="pt-000051">
                                        <p dir="ltr" class="pt-Normal-000046">
                                            <span lang="es-ES" class="pt-Fuentedeprrafopredeter-000007">Personas relacionadas con el objetivo</span>
