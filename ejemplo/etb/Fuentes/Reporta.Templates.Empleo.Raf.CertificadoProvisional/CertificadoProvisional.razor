<!-- Todos los reportes deben heredar de la clase SsidArqNetReportBase -->

@inherits SsidArqNetReportBase<CertificadoProvisional.DatosInforme>

<!-- Aquí comienza el reporte -->

<SsidArqNetReportPage>

    <div class="margenpagina">

        <table style="margin-top:20px; margin-bottom:50px;">
            <tr>
                <td width="60%" style="text-align:left;">
                    <img alt="LogoEducacion" class="logo" src="data:image/png;base64," />
                </td>
                <td width="10%">&nbsp;</td>
                <td>
                    <p class="fuente8pt negrita">
                        Servicio de Planificación e Integración de la Formación Profesional<br />
                        C/ Santo Domingo 8  31001 Pamplona/Iruña<br />
                        sfpeduca@navarra.es
                    </p>
                </td>
            </tr>
        </table>

        <p class="fuentePredeterminada negrita">
            @Model.DirectorServicio
            <br />
            @if (Model.Idioma == "es")
            {
                <text>
                    HACE CONSTAR:
                </text>
            }
            else
            {
                <text>
                    HAU JASOTZEN DU:
                </text>
            }
        </p>

        <br />

        <p class="fuentePredeterminada">
            @GenerarParrafo1()
        </p>

        <br />
        <p class="fuentePredeterminada centrado negrita">
            @Model.Certificado
        </p>

        <br />
        <p class="fuentePredeterminada">
            @if (Model.Idioma == "es")
            {
                <text>
                    Y para que conste y obre los efectos a que haya lugar, en tanto le sea expedido el Certificado definitivo, se expide la presente, a petición de la persona interesada.
                </text>
            }
            else
            {
                <text>
                    Eta jasota gera dadin eta dagozkion ondorioak izan ditzan, behin betiko ziurtagiria ematen zaion bitartean, idazki hau ematen da, interesdunak eskatuta
                </text>
            }
        </p>

        <br />
        <br />
        <p class="fuentePredeterminada centrado">
            <img alt="Firma del responsable" width="70%" src="data:image/png;base64," />
        </p>

    </div>

</SsidArqNetReportPage>

<!-- Añadimos los estilos dentro del head del documento html generado -->

<SectionContent SectionName="@HeadContentSectionId">

    <style>

        .fuentePredeterminada {
            font-family: Calibri;
            font-size: 16pt;
            font-style: normal;
            font-weight: normal;
            margin: 0;
            padding: 0;
            text-align: justify;
            word-spacing: 2px;
        }

        .fuente8pt {
            font-family: Calibri;
            font-size: 9pt;
            margin: 0;
            padding: 0;
        }

        .negrita {
            font-weight: bold;
        }

        .centrado {
            text-align: center;
        }

        .margenpagina {
            margin-left: 80px;
            margin-right: 80px;
        }

        .logo {
            width: 350px;
            height: auto;
        }

    </style>

</SectionContent>

@code {

    public class DatosInforme
    {
        public string DirectorServicio { get; set; }
        public string PersonaCertificado { get; set; }
        public string NumIdentificacion { get; set; }
        public string Certificado { get; set; }
        public string Idioma { get; set; }
    }

    private string GenerarParrafo1()
    {
        if (Model.Idioma == "es")
            return $"Que, de acuerdo con los datos obrantes en el Servicio de Planificación e Integración de la Formación Profesional, {Model.PersonaCertificado}, con DNI/NIE {Model.NumIdentificacion}, superó el procedimiento con evaluación positiva y habiendo solicitado y satisfecho las tasas correspondientes, está a la espera de la expedición del Certificado Profesional:";
        else
            return $"Lanbide Heziketako Plangintza eta Integrazio Zerbitzuan dauden datuen arabera {Model.PersonaCertificado}, (NAN / AIZ) {Model.NumIdentificacion}, prozedura gainditu zuen ebaluazio positiboarekin, eta dagozkion tasak eskatu eta ordaindu ondoren, Lanbide Ziurtagiria noiz emango zain dago:";
    }

}
