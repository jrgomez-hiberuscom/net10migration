<!-- Todos los reportes deben heredar de la clase SsidArqNetReportBase -->
@inherits SsidArqNetReportBase<SolicitudPreinscripcionLote.SolicitudPreinscripcionModelo>
<!-- Aquí comienza el reporte -->
<style>
    .container {
        border: 1px solid #000;
        padding: 20px;
        margin: 0 auto;
        font-family: Arial, sans-serif;
        color: #000;
        line-height: 1.5;
        font-size: 9pt;
        width: 100%;
        min-height: 25cm;
        position: relative;
        box-sizing: border-box;
    }

    .header {
        width: 100%;
        border-bottom: 1px solid black;
        padding-bottom: 8px;
        margin-bottom: 10px;
    }

    .header-table,
    .header-table-cuatro {
        width: 100%;
        border-collapse: collapse;
        text-align: center;
    }

        .header-table td {
            width: 20%;
            text-align: center;
        }

        .header-table img {
            max-height: 30px;
        }

        .header-table-cuatro td {
            width: 25%;
            text-align: center;
        }

        .header-table-cuatro img {
            max-height: 30px;
        }

    h1 {
        text-align: center;
        font-size: 20px;
        margin-bottom: 10px;
        font-weight: bold;
    }

    .section {
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #ccc;
    }

    .label {
        font-weight: bold;
        display: inline-block;
        /* width: 250px; */
        vertical-align: top;
    }

    .value {
        display: inline-block;
        /* width: calc(100% - 260px); */
        margin-left: 3px;
        vertical-align: top;
    }

    .note {
        font-size: 12px;
        color: #555;
        margin-top: 8px;
    }

    /* Bloque superior de meta (sin flex: floats) */
    .top-meta {
        overflow: hidden;
        width: 100%;
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .top-left {
        float: left;
        font-size: 9pt;
    }

    .top-right {
        float: right;
        font-size: 9pt;
        text-align: right;
    }

</style>


    @{
        // === Diccionario de imágenes (igual que tu snippet) ===
        diccionarioImagenes.Add("MRR_FSE", logoMRR_FSE);
        diccionarioImagenes.Add("MRR_GE", logoMRR_GE);
        diccionarioImagenes.Add("MRR_PlanRecuperacion", logoMRR_PlanRecuperacion);
        diccionarioImagenes.Add("SNE_NL", logoSNE_NL);
        diccionarioImagenes.Add("SEPE", logoSEPE);
        diccionarioImagenes.Add("D_Educacion", logoD_Educacion);
        diccionarioImagenes.Add("M_Educacion", logoM_Educacion);
        diccionarioImagenes.Add("M_EducacionFP", logoM_EducacionFP);
        diccionarioImagenes.Add("FSE", logoFSE);
        diccionarioImagenes.Add("GN", logoGN);
        diccionarioImagenes.Add("GN_2030", logoGN_2030);
        diccionarioImagenes.Add("LINKK", logoLINKK);
        diccionarioImagenes.Add("MRR_GE_Ministerio", logoMRR_GE_Ministerio);
        diccionarioImagenes.Add("FUE", logoFUE);
        diccionarioImagenes.Add("MRR_PlanRecuperacion_Bilingue", logoMRR_PlanRecuperacion_Bilingue);
        diccionarioImagenes.Add("M_Transicion", logoM_Transicion);
        diccionarioImagenes.Add("SNE_2024", logoSNE_2024);

        var imagenes = new[]
        {
        Model.Cabecera.Logo1 ?? "",
        Model.Cabecera.Logo2 ?? "",
        Model.Cabecera.Logo3 ?? "",
        Model.Cabecera.Logo4 ?? "",
        Model.Cabecera.Logo5 ?? ""
        };

        var posiciones = new[] { 0, 1, 2, 3, 4 };
        var imagenesValidas = new List<(string img, int index, string src)>();
        int index = 0;
        foreach (var img in imagenes)
        {
            if (diccionarioImagenes.TryGetValue(img, out var src) && !string.IsNullOrEmpty(src))
            {
                imagenesValidas.Add((img, index, src));
            }
            index++;
        }

        var totalImagenes = imagenesValidas.Count;
        List<int> posicionesFinales = new();

        switch (totalImagenes)
        {
            case 5:
                posicionesFinales.AddRange(posiciones);
                break;
            case 4:
                posicionesFinales = new List<int> { 0, 1, 3, 4 };
                break;
            case 3:
                posicionesFinales = new List<int> { 0, 2, 4 };
                break;
            case 2:
                posicionesFinales = new List<int> { 0, 4 };
                break;
            case 1:
                var originalIndex = imagenesValidas[0].index;
                if (originalIndex == 0)
                    posicionesFinales = new List<int> { 0 };
                else if (originalIndex == 1)
                    posicionesFinales = new List<int> { 2 };
                else
                    posicionesFinales = new List<int> { 4 };
                break;
            default:
                posicionesFinales.AddRange(posiciones);
                break;
        }
    }
    
    @if (Model.Preinscripciones != null && Model.Preinscripciones.Any())
{
    foreach (var preinscripcion in Model.Preinscripciones)
    {
        <SsidArqNetReportPage>
    <div class="container">
        <div class="header">
            @if (totalImagenes != 4)
            {
                <table class="header-table">
                    <tr>
                        @for (int i = 0; i < 5; i++)
                        {
                            <td style="text-align:center;">
                                @{
                                    int indexInFinal = posicionesFinales.IndexOf(i);
                                    if (indexInFinal != -1 && indexInFinal < imagenesValidas.Count)
                                    {
                                        var imgSrc = imagenesValidas[indexInFinal].src;
                                        if (!string.IsNullOrEmpty(imgSrc))
                                        {
                                            <img src="@imgSrc" alt="Logo @(i + 1)" />
                                        }
                                    }
                                    else
                                    {
                                        <div style="height:30px;"></div>
                                    }
                                }
                            </td>
                        }
                    </tr>
                </table>
            }
            else
            {
                <table class="header-table-cuatro">
                    <tr>
                        @for (int i = 0; i < 5; i++)
                        {
                            int indexInFinal = posicionesFinales.IndexOf(i);
                            if (indexInFinal != -1 && indexInFinal < imagenesValidas.Count)
                            {
                                var imgSrc = imagenesValidas[indexInFinal].src;
                                if (!string.IsNullOrEmpty(imgSrc))
                                {
                                    <td style="text-align:center;">
                                        <img src="@imgSrc" alt="Logo @(i + 1)" />
                                    </td>
                                }
                            }
                        }
                    </tr>
                </table>
            }
        </div>

        <div style="text-align:left; color:red">
            <h1 style="text-align:left;">Información de solicitud de preinscripción al curso</h1>
        </div>

        <div class="section">
            <span class="label">Nombre y Apellidos:</span><span class="value">@preinscripcion.NombreCompleto</span><br />
            <span class="label">NIF/NIE:</span><span class="value">@preinscripcion.DnieNie</span><br />
            <span class="label">Fecha de nacimiento:</span><span class="value">@preinscripcion.FechaNacimiento.Date.ToShortDateString()</span><br />
            <span class="label">Sexo:</span><span class="value">
                @(
                                preinscripcion.IdSexo == 1 ? "Masculino" :
                                preinscripcion.IdSexo == 2 ? "Femenino" :
                                "Sin especificar"
                 )
            </span><br />
                <span class="label">Teléfono fijo 1:</span><span class="value">@preinscripcion.TelefonoFijo</span><br />
        <span class="label">Teléfono fijo 2:</span><span class="value">@preinscripcion.TelefonoFijo2</span><br />
                <span class="label">Teléfono móvil 1:</span><span class="value">@preinscripcion.TelefonoMovil</span><br />
        <span class="label">Teléfono móvil 2:</span><span class="value">@preinscripcion.TelefonoMovil2</span><br />
                <span class="label">Correo electrónico:</span><span class="value">@preinscripcion.CorreoElectronico</span><br />

                <span class="label">Nivel educativo:</span><span class="value">@preinscripcion.DescNivelEducativo</span><br />
        <span class="label">Situación laboral:</span><span class="value">@preinscripcion.DescSituacionLaboral</span><br />
                <span class="label">Discapacidad con un grado igual o mayor al 33%, o incapacidad permanente total:</span><span class="value">@preinscripcion.DescDiscapacidad</span><br />
                    <span class="label">Otros datos:</span><span class="value">@preinscripcion.OtrosDatos</span><br />
    </div>

    <div class="section">
        <span class="label">Curso:</span><span class="value"><span class="value">@preinscripcion.Denominacion</span></span><br />
        <span class="label">Nº Curso:</span><span class="value"><span class="value">@preinscripcion.Codigo</span></span><br />
        <span class="label">Horario:</span><span class="value">@preinscripcion.Horario</span><br />
        <span class="label">Horas:</span><span class="value">@preinscripcion.Horas</span><br />
        <span class="label">Fecha Inicio:</span><span class="value">@preinscripcion.FechaInicio.Date.ToShortDateString()</span><br />
        <span class="label">Entidad que imparte el curso:</span><span class="value">@preinscripcion.DescEntidadImparticion</span><br />
        <span class="label">Dirección y teléfono del lugar de impartición del curso:</span>
        <span class="value">@preinscripcion.DireccionEntidad @preinscripcion.Telefono</span><br />
        <span class="label">Fecha de registro de la solicitud:</span><span class="value">@preinscripcion.FechaSolicitud</span><br />
        <span class="label">Agencia de empleo que tramita la preinscripción:</span><span class="value">@preinscripcion.DescEntidadGestion</span><br />
        <span class="label">Información de interés:</span><span class="value">@preinscripcion.InformacionInteres</span>

    </div>

        <div class="declaration-box">
            <div class="declaration-title">La persona solicitante declara:</div>
            <ul class="declaration-list">
                <li>Que toda la información aportada en la presente solicitud es cierta.</li>
                <li>Haber leído y aceptado las condiciones de acceso a los cursos.</li>
                <li>Haber leído y aceptado la información sobre protección de datos.</li>
            </ul>
        </div>
</div>
<footer style="font-size:9pt">
    <p class="note">La entidad que imparte esta formación se pondrá en contacto con las personas solicitantes para comunicar el resultado de la selección.</p>
    <p>Fecha generación: @System.DateTime.Today.ToString("dddd", new System.Globalization.CultureInfo("es-ES")), @System.DateTime.Today.Day @System.DateTime.Today.ToString("MMMM", new System.Globalization.CultureInfo("es-ES")), @System.DateTime.Today.Year</p>
</footer>
</SsidArqNetReportPage>
}
}




