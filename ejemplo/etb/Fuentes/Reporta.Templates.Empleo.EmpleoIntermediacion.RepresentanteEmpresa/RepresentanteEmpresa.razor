<!-- Todos los reportes deben heredar de la clase SsidArqNetReportBase -->
@inherits SsidArqNetReportBase<RepresentanteEmpresa.Persona>
<!-- Aquí comienza el reporte -->

<SsidArqNetReportPage>
    <head>
        <meta charset="UTF-8">
        <title>Autorización para Tramitación de Ofertas</title>
        <style>
            body {
                font-family: Calibri, sans-serif;
            }

            th, td {
                padding: 15px;
                text-align: center;
            }

            table.header {
                width: 100%;
            }

                table.header td {
                    vertical-align: top;
                }

            .header-text {
                text-align: right;
                font-size: small;
            }

            .box {
                display: inline-block;
                padding: 4px 8px;
                min-width: 200px;
                background-color: #F4F4F4;
            }

            .small-box {
                display: inline-block;
                padding: 4px 8px;
                min-width: 100px;
                background-color: #F4F4F4;
            }

            .large-box {
                display: inline-block;
                padding: 4px 8px;
                min-width: 600px;
                background-color: #F4F4F4;
            }
        </style>
    </head>
    <body>
        <img src="data:image/png;base64," alt="Logo" width="241" height="82">
        @* <table class="header">
            <tr>
                <td><img src="data:image/png;base64," alt="Logo" width="241" height="82"></td>
                <td class="header-text">
                    <p>Servicio de Fomento del Empleo y Servicios a Empresas<br>
                        Sección de Servicios a Empresas<br>
                        Avda. Villava 1, 1ª planta<br>
                        31600 Burlada<br>
                        Telf: 848425801
                    </p>
                </td>
            </tr>
        </table> *@
        <div style="background-color:#E1E1E1">
            <h3 style="text-align:center;">AUTORIZACIÓN ENTRE PARTICULARES PARA TRAMITAR<br /> OFERTAS DE EMPLEO A TRAVÉS DEL SNE-NL</h3>
        </div>

        <span style="font-weight:bold">Solicitud presentada por:</span>
        <br />

        <p>D/Dña. 
            <span class="box">@Model.NombreApellidos</span> con DNI/NIE <span class="box">@Model.DNI</span>
        </p>
        <p>Teléfono <span class="box">@Model.Telefono</span> Correo electrónico <span class="box">@Model.CorreoElectronico</span></p>

        <span style="font-weight:bold">Manifiesta que actuará en representación de:</span>
        <br />

        <p>D/Dña.
            <span class="large-box">@Model.NombreRepresentando</span>
        </p>
        <p>con NIF/DNI/NIE <span class="box">@Model.DNIRepresentando</span> y CCC <span class="box">@Model.CCCRepresentando</span></p>
        <p>Dirección
            <span class="large-box">@Model.Direccion</span>
        </p>
        <p>Municipio <span class="box">@Model.Municipio</span> C.P. <span class="small-box">@Model.CodigoPostal</span> Provincia <span class="small-box">@Model.Provincia</span></p>

        <p>Para la tramitación de ofertas de empleo en la Plataforma del SNE-NL.</p>
        <p>
            Este documento se debe cumplimentar únicamente junto con el alta de la entidad.
            Posteriormente, las consultas y modificaciones de personas autorizadas, deberán realizarse desde
            su perfil de usuario.
        </p>

        <p>En <span class="box">@Model.LugarEmision</span>, a <span class="small-box">@Model.FechaEmision.Date.Day</span> de <span class="small-box">@Model.FechaEmision.ToString("MMMM", new System.Globalization.CultureInfo("es-ES"))</span> de @Model.FechaEmision.Date.Year.</p>
    
        <div style="align-content:center; text-align:center">
            <p>Firmado <span class="box">@Model.NombreApellidos</span> </p>
        </div>


        <div style="border: 1px solid #000;font-size:small">
            Los datos personales aportados se utilizarán únicamente para la gestión de la oferta presentada, y gozan de la protección que fija el Reglamento Europeo de Protección de Datos (UE) 2016/679 de 27 de abril de 2016. Para más información, puede consultar en https://gobiernoabierto.navarra.es/sites/default/files/rat-sne-nl.pdf
            El/la suscribiente podrá ejercitar sus derechos de acceso, rectificación, cancelación y oposición relativos a este tratamiento ante el Servicio Navarro de Empleo-Nafar Lansare como responsable del mismo.
        </div>
    
    </body>
</SsidArqNetReportPage>




@code {
    public class Persona
    {
        public string NombreApellidos { get; set; }
        public string DNI { get; set; }
        public string Telefono { get; set; }
        public string CorreoElectronico { get; set; }
        public string NombreRepresentando { get; set; }
        public string DNIRepresentando { get; set; }
        public string CCCRepresentando { get; set; }
        public string Direccion { get; set; }
        public string Municipio { get; set; }
        public string CodigoPostal { get; set; }
        public string Provincia { get; set; }
        public string LugarEmision { get; set; }
        public DateTime FechaEmision { get; set; }
    }
}
